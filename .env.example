# Zetaris (local install from zetaris-platform/)
ZETARIS_REST_URL=http://localhost:8888/api/v1.0
ZETARIS_ORG_ID=1
ZETARIS_API_KEY=your-zetaris-api-key

# Meterless Nightshift runtime (Console tab shows the real URL and token)
METERLESS_BASE_URL=http://127.0.0.1:8088/v1
METERLESS_RUNTIME_TOKEN=your-nightshift-runtime-token
METERLESS_MODEL=meterless/fast

# Offline mode: deterministic LLM stub + local SQLite federation instead of Zetaris
SAMPLE_MODE=false

# Synthetic sources Postgres sidecar (infra/sources): logsdb / policydb / ticketsdb
SOURCES_DB_PASSWORD=change-me

# Runtime behaviour
LOG_LEVEL=INFO
PORT=8000
