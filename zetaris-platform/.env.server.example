# For running the platform on a server, where a browser on another machine has to reach it.
#
#   cp .env.server.example .env
#
# Set ZETARIS_ADMIN_PASSWORD, then replace <public-ip> in the three addresses below with this
# machine's public address, hyphenated: 54.1.2.3 becomes 54-1-2-3.

# ---------------------------------------------------------------------------
# Images
# ---------------------------------------------------------------------------
DRIVER_IMAGE=zetarishackathon.azurecr.io/zetaris-ndp-driver:2.4.3-v2.4.3.1-hackathon.cb88df0b255aba5a9a9eda96483fc877cc82df80
API_IMAGE=zetarishackathon.azurecr.io/zetaris-ndp-api:2.4.3-v2.4.3.1-hackathon.a2848d8a41fa21673a0d719deb41b675412710fe
UI_IMAGE=zetarishackathon.azurecr.io/zetaris-new-ui:2.4.3-v2.4.3.1-hackathon.88e49b0db015979a2d071d2d68a6865d38a39f15

# ---------------------------------------------------------------------------
# Your administrator account
# ---------------------------------------------------------------------------
# No default here, unlike .env: this file publishes the platform on a public
# address, so a known password would be an open door. Pick one before the first start --
# the account is created once and editing this afterwards does nothing.
#
# At least 8 characters, with a lower case letter, an upper case letter, a digit,
# and one of:  $ @ ! % * ? &     Other punctuation is rejected and the first start fails.
ZETARIS_ADMIN_PASSWORD=
ZETARIS_ADMIN_EMAIL=admin@zetaris.com
ZETARIS_ADMIN_ORG=zetaris

# The database. Not published outside this deployment's network, so this is a fixed value.
# Changing it after the first start locks the platform out of its own database: Postgres only
# applies a password when it creates an empty data directory.
POSTGRES_USER=zetaris
POSTGRES_PASSWORD=zt-metastore-6f2a9c41d0b7

# ---------------------------------------------------------------------------
# Sizing -- the one choice that decides how fast queries run
# ---------------------------------------------------------------------------
# Sized for an instance with room. Lower these to 2g / 2 / local[2] / 1g on a small machine:
# asking for more heap than the host has means the query engine never starts.
ZSPARK_DRIVER_MEM=4g
ZSPARK_DRIVER_CORES=4
ZSPARK_MASTER_URL=local[4]
ZETARIS_API_MAX_HEAP=2g

# ---------------------------------------------------------------------------
# Addresses
# ---------------------------------------------------------------------------
# Start Caddy, which serves HTTPS and obtains the certificate. A browser will not run the
# interface over plain HTTP at anything but localhost.
COMPOSE_PROFILES=tls

# Any name ending .<ip>.sslip.io resolves to that IP through public DNS, so there is no
# record to create. All three must agree or the browser's origin check fails.
ZETARIS_PUBLIC_HOST=lightning.<public-ip>.sslip.io
ALLOWED_ORIGINS=https://lightning.<public-ip>.sslip.io
GUI_URL=https://lightning.<public-ip>.sslip.io
UI_PORT=3000

# Set this to local_certs for a private address, which no certificate authority can validate.
# Caddy then signs its own and the browser warns once per name.
CADDY_GLOBAL_OPTIONS=

# Bound to this machine only. Nothing here needs to be reachable from the network.
API_PORT=8888
API_INTERNAL_PORT=8889
DRIVER_PORT=10000
SPARK_UI_PORT=4040

# ---------------------------------------------------------------------------
# Fleet key
# ---------------------------------------------------------------------------
# Identifies this as a real Zetaris bundle when usage reporting is switched on.
# The same value in every copy, so it says nothing about who you are. Leave it
# alone; clearing it only means the reports are ignored.
TELEMETRY_KEY=5e3d4963-f601-4d90-adca-506755f3e7c6

# ---------------------------------------------------------------------------
# Anonymous usage reporting
# ---------------------------------------------------------------------------
# Every few hours the platform posts a random id minted on this machine, its version,
# the OS and architecture, and how long it has been up. Nothing else: no account, no
# email, no hostname, no IP kept, and no query or data of yours. It is how we count
# how many of these installs are running.
#
# Leave this blank and the platform asks you once, the first time you open it, and
# sends nothing until you answer. Set it to false to decline up front and never be
# asked, or true to accept up front.
TELEMETRY_ENABLED=
