# Global options.
#
# Empty for a normal deployment: Caddy obtains and renews a Let's Encrypt certificate, which
# needs port 80 reachable and the name in public DNS.
#
# CADDY_GLOBAL_OPTIONS=local_certs makes Caddy sign its own instead, for trying the stack out
# against a hostname that exists only in /etc/hosts. The browser warns once per name.
#
# Never set it for a deployment real users reach.
{
	{$CADDY_GLOBAL_OPTIONS}
}

# TLS front end for the platform.
#
# HTTPS is required, not advisable. Browsers withhold part of their JavaScript API from
# pages served over plain HTTP at a hostname, and the interface depends on it. Publishing
# 3000 directly works only at localhost.
{$ZETARIS_PUBLIC_HOST} {
    encode zstd gzip
    reverse_proxy ui:3000
}

# The REST API.
#
# Notebook and DAG code that queries Lightning needs an address; `api:8888` resolves only
# inside this deployment.
#
# 8888 only. The API also listens on 8889, which carries an internal login route that must
# not be reachable from outside.
api.{$ZETARIS_PUBLIC_HOST} {
    encode zstd gzip
    reverse_proxy api:8888
}
